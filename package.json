{
  "name": "dev-english-gym",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "vite",
    "dev:backend": "convex dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p convex --noEmit"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "0.0.98",
    "convex": "^1.51.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  }
}
